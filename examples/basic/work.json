{
	"$schema": "https://raw.githubusercontent.com/BarakChamo/good-work/v0.5.1/schemas/work.schema.json",
	"version": 1,
	"hooks": {
		"afterEdit": [
			{
				"id": "check-typescript",
				"command": "bun",
				"args": [
					"run",
					"typecheck"
				],
				"when": {
					"changedFiles": {
						"source": "workingTree",
						"include": [
							"**/*.ts",
							"**/*.tsx"
						]
					}
				},
				"output": {
					"mode": "summarize",
					"when": "failure",
					"instruction": "Summarize actionable type errors without reproducing successful output."
				}
			}
		]
	}
}
